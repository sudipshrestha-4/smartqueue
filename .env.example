FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-string

# Database — SQLite for local dev, swap to MySQL later
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smartqueue_db

# For MySQL later, it'll look like:
# DATABASE_URL=mysql+pymysql://username:password@localhost/smartqueue_db